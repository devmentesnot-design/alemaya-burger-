{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["database.json", "server.js", "supabase_db.js"]
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/kitchen", "dest": "/index.html" },
    { "src": "/admin", "dest": "/index.html" },
    { "src": "/orders", "dest": "/index.html" }
  ]
}
